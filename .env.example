# Copy this file to .env and put your own OpenRouter key in it (https://openrouter.ai/keys).
# .env is gitignored, so each person keeps their own key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Which model you are testing: 1, 2 or 3 (see: python cfg_agent.py --list-models).
# You can still override it for one run with --model.
CFG_MODEL=1
